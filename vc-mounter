def human_size(nbytes):
    n = float(nbytes or 0)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
        if n < 1024 or unit == "PiB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024.0


def list_partitions():
    """All partitions in the system (whole disks intentionally skipped)."""
    # Flat list (-l): lsblk only nests partitions under their disk when the
    # NAME column is requested, so the disk model is looked up through
    # PKNAME (the parent's kernel name) instead.
    out = subprocess.run(
        ["lsblk", "-J", "-b", "-l", "-o",
         "KNAME,PKNAME,PATH,TYPE,SIZE,MODEL,FSTYPE"],
        capture_output=True, text=True, check=True,
    ).stdout
    devices = json.loads(out).get("blockdevices", [])
    models = {d.get("kname"): (d.get("model") or "").strip()
              for d in devices}
    parts = [{"path": d["path"],
              "size": d.get("size") or 0,
              "model": models.get(d.get("pkname"), ""),
              "fstype": d.get("fstype") or ""}
             for d in devices if d.get("type") == "part"]
    parts.sort(key=lambda p: p["path"])
    return parts


def by_id_map():
    """realpath -> preferred /dev/disk/by-id/... symlink."""
    m = {}
    for link in glob.glob("/dev/disk/by-id/*"):
        m.setdefault(os.path.realpath(link), []).append(link)
    best = {}
    for real, links in m.items():
        # Prefer human-readable ata-/usb-/nvme-<model>_<serial> names over
        # wwn-/eui/dm- forms; all are equally stable.
        links.sort(key=lambda l: (
            os.path.basename(l).startswith(("wwn-", "nvme-eui.", "dm-")),
            len(l),
        ))
        best[real] = links[0]
    return best


def load_config():
    try:
        with open(CONFIG_FILE, "r") as f:
            data = json.load(f)
        return [v for v in data.get("volumes", []) if isinstance(v, str)]
    except (OSError, ValueError):
        return []


def save_config(volume_ids):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"volumes": volume_ids}, f, indent=2)
    os.replace(tmp, CONFIG_FILE)


def _unescape_mount_field(s):
    """Decode the \\ooo octal escapes used in /proc/mounts."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)


def mounted_veracrypt_devices():
    """Real mount state, read without root.

    Returns {"/dev/sdXY": mountpoint} for every partition that currently
    backs an active VeraCrypt dm-crypt mapping (/dev/mapper/veracryptN).
    mountpoint is "" if the mapping exists but no filesystem is mounted.
    """
    mounts = {}
    n_volumes = 0          # VeraCrypt keeps one "fuse.veracrypt" mount each
    try:
        with open("/proc/self/mounts") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and parts[2] == "fuse.veracrypt":
                    n_volumes += 1
                if len(parts) >= 2 and parts[0].startswith("/dev/"):
                    src = os.path.realpath(_unescape_mount_field(parts[0]))
                    mounts.setdefault(src, _unescape_mount_field(parts[1]))
    except OSError:
        pass

    # VeraCrypt creates one dm-crypt layer per cipher. A single cipher gives
    # just "veracryptN" on the partition; a cascade stacks "veracryptN_1",
    # "veracryptN_0", ... under the top "veracryptN", which is what gets
    # mounted. Walk from each top layer down to the real partition.
    dms = {}                               # "dm-3" -> (name, [slaves])
    for dm in glob.glob("/sys/block/dm-*"):
        try:
            with open(os.path.join(dm, "dm", "name")) as f:
                name = f.read().strip()
        except OSError:
            continue
        try:
            slaves = os.listdir(os.path.join(dm, "slaves"))
        except OSError:
            slaves = []
        dms[os.path.basename(dm)] = (name, slaves)

    def base_devices(node, depth=0):
        if node in dms and depth < 8:
            out = []
            for slave in dms[node][1]:
                out += base_devices(slave, depth + 1)
            return out
        return [node]

    result = {}
    n_traced = 0           # volumes followed down to a real partition
    for node, (name, _) in dms.items():
        if not re.fullmatch(r"veracrypt\d+", name):
            continue                       # inner cascade layers, other dm
        mp = mounts.get("/dev/" + node, "")
        bases = base_devices(node)
        for base in bases:
            result["/dev/" + base] = mp
        if bases and not any(b.startswith("loop") for b in bases):
            n_traced += 1
    if n_traced >= n_volumes:
        return result      # the usual case: no subprocess needed

    # Fallback for volumes that sysfs cannot trace to a partition (mapping
    # on a loop device, or no kernel mapping at all with nokernelcrypto):
    # ask veracrypt itself. Non-interactive, so it can never prompt;
    # failures are simply ignored.
    try:
        r = subprocess.run(["veracrypt", "--text", "--non-interactive",
                            "--list"], capture_output=True, text=True,
                           timeout=5)
        for line in r.stdout.splitlines():
            m = re.match(r"\s*\d+:\s+(\S+)\s+\S+\s*(.*)$", line)
            if m and m.group(1).startswith("/dev/"):
                dev = os.path.realpath(m.group(1))
                if dev not in result:
                    mp = m.group(2).strip()
                    # A lazily detached volume may still be listed with its
                    # old folder; only trust mount points that really exist.
                    result[dev] = mp if mp in mounts.values() else ""
    except Exception:
        pass
    return result


def harden_process():
    """No core dumps, no memory reads by other processes of the same user."""
    PR_SET_DUMPABLE = 4
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        ctypes.CDLL(None).prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)
    except (OSError, ValueError, AttributeError):
        pass                               # best effort; never block startup


# Glyph used to mask characters in the password / PIM fields, applied via
# GtkEntry.set_invisible_char() (first-class API, no delegate digging).
#   "\u200B" = zero-width space: nothing is drawn and the caret does not
#              visibly advance, so neither the characters nor the length are
#              exposed (classic pre-sudo-rs behaviour). If any font ever renders
#              it as a fallback box, switch to " " (a plain space): still no dots
#              or asterisks, but the field width then hints at the length.
MASK_CHAR = "\u200B"


# ---------------------------------------------------------------------------
# Autostart handling
# ---------------------------------------------------------------------------
def autostart_enabled():
    return os.path.exists(AUTOSTART_FILE)


def set_autostart(enabled):
    if enabled:
        python = sys.executable or shutil.which("python3") or "/usr/bin/python3"
        script = os.path.abspath(__file__)
        content = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=VeraCrypt Mounter\n"
            "Comment=Mount VeraCrypt volumes by stable device ID\n"
            f"Exec={python} \"{script}\" --hidden\n"
            "Icon=drive-harddisk\n"
            "Terminal=false\n"
            "X-GNOME-Autostart-enabled=true\n"
        )
        os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
        with open(AUTOSTART_FILE, "w") as f:
            f.write(content)
        os.chmod(AUTOSTART_FILE, 0o644)
    else:
        try:
            os.remove(AUTOSTART_FILE)
        except FileNotFoundError:
            pass


# ---------------------------------------------------------------------------
# One configured volume
# ---------------------------------------------------------------------------
@dataclasses.dataclass
class Volume:
    """A configured volume and everything currently known about it."""
    dev_id: str                      # /dev/disk/by-id/... (the stable name)
    dev: str | None = None           # current /dev/sdXY; None = not connected
    mountpoint: str | None = None    # None = not mounted; "" = decrypted
                                     # device open but no filesystem mounted
    error: str = ""                  # last mount/dismount failure (RAM only)
    pending: str | None = None       # after a force dismount: the programs
                                     # still holding it; None = not pending
    st_lbl: object = None            # the row's status label

    @property
    def name(self):
        return os.path.basename(self.dev_id)

    @property
    def mounted(self):
        return self.mountpoint is not None

    @property
    def detached(self):
        """Force-dismounted: folder gone, key in memory until files close."""
        return self.mounted and self.pending is not None \
            and not self.mountpoint

    def status_text(self):
        if self.detached:
            return ("detached, cleanup pending until "
                    + (f"{self.pending} closes" if self.pending
                       else "open files are closed"))
        if self.mounted and self.error:
            return f"still mounted: {self.error}"   # e.g. busy on dismount
        if self.mounted:
            return (f"mounted ✓  {self.mountpoint}" if self.mountpoint
                    else "not mounted, but decrypted device still open "
                         "(key in memory)")
        if self.dev is None:
            return "not connected"
        return self.error or "present"


# ---------------------------------------------------------------------------
# GUI
# ---------------------------------------------------------------------------
class VCMounter(Gtk.Application):
    def __init__(self, start_hidden=False):
        super().__init__(application_id="eu.arizone.vcmounter")
        self.start_hidden = start_hidden
        self.win = None
        self.config_checks = []      # [(CheckButton, by_id_path)]
        self.volumes = {}            # by_id_path -> Volume (configured ones)
        self.busy = {}               # /dev path -> holders, after a failed
                                     # dismount (any VeraCrypt volume)
        self.pending_poll = 0        # GLib source id while cleanup is pending
        self.mount_started = 0.0
        self.mount_proc = None         # running mount helper (cancel channel)
        self.mount_busy = False
        self.tray_proc = None
        self.tray_ok = False
        self.quitting = False

    # ---------- window ----------
    def do_activate(self):
        if self.win is not None:
            self.win.present()
            return

        css = Gtk.CssProvider()
        css.load_from_data(b".mono { font-family: monospace; }")
        Gtk.StyleContext.add_provider_for_display(
            Gtk.Widget.get_display(Gtk.Label()),
            css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.hold()  # stay alive while hidden in the tray

        self.win = Gtk.ApplicationWindow(application=self,
                                         title="VeraCrypt Mounter")
        self.win.set_default_size(860, 600)
        self.win.connect("close-request", self.on_close_request)

        self.nb = Gtk.Notebook()
        self.nb.append_page(self._build_config_tab(),
                            Gtk.Label(label="Config"))
        self.nb.append_page(self._build_mapping_tab(),
                            Gtk.Label(label="Mapping"))
        self.nb.append_page(self._build_about_tab(),
                            Gtk.Label(label="About"))
        self.win.set_child(self.nb)

        if not self.start_hidden:
            self.win.present()

        missing = [t for t in ("veracrypt", "pkexec", "lsblk")
                   if shutil.which(t) is None]
        if missing:
            self._config_status(f"Missing tools: {', '.join(missing)}")
        elif not os.access(HELPER, os.X_OK):
            self._config_status(
                f"Root helper not installed ({HELPER}). "
                "Run: sudo ./install.sh")

        self.start_tray()
        self.refresh_config_tab()
        self.refresh_mapping_tab()

    def on_close_request(self, *_):
        if self.tray_ok:
            self.hide_window()
            return True          # hide to tray instead of closing
        self.quit_app()
        return True

    def quit_app(self):
        self.quitting = True
        self.on_cancel_mount()          # never leave mounts running behind us
        if self.win is not None:
            self.wipe_secrets()
        self.tray_send("QUIT")
        if self.tray_proc is not None:
            try:
                self.tray_proc.wait(timeout=2)
            except Exception:
                self.tray_proc.terminate()
        self.release()
        self.quit()

    # ---------- tray helper ----------
    def start_tray(self):
        if not os.path.isfile(TRAY_SCRIPT):
            self._config_status(f"Tray unavailable ({TRAY_SCRIPT} is "
                                "missing) — close will quit the app.")
            return
        try:
            self.tray_proc = subprocess.Popen(
                [sys.executable or "python3", "-I", TRAY_SCRIPT],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, text=True, bufsize=1)
        except Exception:
            self.tray_proc = None
            self._config_status("Tray unavailable — close will quit the app.")
            return
        self.tray_ok = True
        threading.Thread(target=self._tray_reader, daemon=True).start()

    def _tray_reader(self):
        proc = self.tray_proc
        for line in proc.stdout:
            GLib.idle_add(self.on_tray_cmd, line.strip())
        proc.wait()
        GLib.idle_add(self.on_tray_exit, proc.returncode)

    def on_tray_exit(self, code):
        self.tray_ok = False
        if self.quitting:
            return False
        if code == 3:
            self._config_status(
                "Tray icon unavailable: install "
                "gir1.2-ayatanaappindicator3-0.1 and enable the GNOME "
                "AppIndicator extension. Close will quit the app.")
        else:
            self._config_status("Tray helper exited — close will quit.")
        if self.win is not None and not self.win.get_visible():
            self.win.present()   # never leave the app unreachable
        return False

    def on_tray_cmd(self, cmd):
        if cmd == "TOGGLE":
            if self.win.get_visible():
                self.hide_window()
            else:
                self.win.present()
        elif cmd == "MOUNT":
            self.win.present()
            self.nb.set_current_page(1)
            self.refresh_mapping_tab()
            self.pw_entry.grab_focus()
        elif cmd == "DISMOUNT":
            self.on_dismount_all()
        elif cmd == "QUIT":
            self.quit_app()
        return False

    def tray_send(self, line):
        if self.tray_proc is None or self.tray_proc.poll() is not None:
            return
        try:
            self.tray_proc.stdin.write(line + "\n")
            self.tray_proc.stdin.flush()
        except Exception:
            pass

    # ---------- Config tab ----------
    def _build_config_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=10, margin_bottom=10,
                      margin_start=10, margin_end=10)

        info = Gtk.Label(
            label="Check the partitions that are VeraCrypt volumes. "
                  "Selection is stored by stable /dev/disk/by-id path.",
            xalign=0, wrap=True)
        box.append(info)

        self.config_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        sw = Gtk.ScrolledWindow(vexpand=True)
        sw.set_child(self.config_list)
        box.append(sw)

        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        b_refresh = Gtk.Button(label="Refresh disks")
        b_refresh.connect("clicked", lambda *_: self.refresh_config_tab())
        b_save = Gtk.Button(label="Save selection")
        b_save.add_css_class("suggested-action")
        b_save.connect("clicked", self.on_save_config)
        btns.append(b_refresh)
        btns.append(b_save)
        box.append(btns)

        self.autostart_check = Gtk.CheckButton(
            label="Start at login (minimized to tray)")
        self.autostart_check.set_active(autostart_enabled())
        self.autostart_check.connect("toggled", self.on_autostart_toggled)
        box.append(self.autostart_check)

        self.config_status_lbl = Gtk.Label(label="", xalign=0, wrap=True)
        box.append(self.config_status_lbl)
        return box

    def on_autostart_toggled(self, check):
        try:
            set_autostart(check.get_active())
            self._config_status(
                f"Autostart {'enabled' if check.get_active() else 'disabled'}"
                f" ({AUTOSTART_FILE})")
        except OSError as e:
            self._config_status(f"Autostart change failed: {e}")

    def _config_status(self, text):
        self.config_status_lbl.set_text(text)

    def refresh_config_tab(self):
        while (row := self.config_list.get_first_child()) is not None:
            self.config_list.remove(row)
        self.config_checks.clear()

        saved = set(load_config())
        ids = by_id_map()
        try:
            parts = list_partitions()
        except Exception as e:
            self._config_status(f"lsblk failed: {e}")
            return

        for p in parts:
            dev_id = ids.get(os.path.realpath(p["path"]))
            fs = p["fstype"] or "no fs detected"
            label = (f'{p["path"]:<16} {human_size(p["size"]):>10}   '
                     f'{p["model"] or "-":<24} {fs:<22} '
                     f'{os.path.basename(dev_id) if dev_id else "(no by-id!)"}')
            check = Gtk.CheckButton(label=label)
            check.add_css_class("mono")
            if dev_id is None:
                check.set_sensitive(False)
            elif dev_id in saved:
                check.set_active(True)
            self.config_checks.append((check, dev_id))
            self.config_list.append(check)

        self._config_status(f"{len(parts)} partition(s) found. "
                            f"{len(saved)} in saved config.")

    def on_save_config(self, *_):
        selected = [dev_id for check, dev_id in self.config_checks
                    if dev_id and check.get_active()]
        try:
            save_config(selected)
        except OSError as e:
            self._config_status(f"Save failed: {e}")
            return
        self._config_status(f"Saved {len(selected)} volume(s) to {CONFIG_FILE}")
        self.refresh_mapping_tab()

