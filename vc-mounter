                  + ("installed" if helper_ok
                     else "not installed — run: sudo ./install.sh"),
            justify=Gtk.Justification.CENTER, selectable=True))
        return box

    # ---------- Mapping tab ----------
    def _build_mapping_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=10, margin_bottom=10,
                      margin_start=10, margin_end=10)

        self.map_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        sw = Gtk.ScrolledWindow(vexpand=True)
        sw.set_child(self.map_list)
        box.append(sw)

        grid = Gtk.Grid(column_spacing=8, row_spacing=8)

        grid.attach(Gtk.Label(label="Password:", xalign=1), 0, 0, 1, 1)
        self.pw_entry = self._make_secret_entry("volume password")
        grid.attach(self.pw_entry, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="PIM:", xalign=1), 0, 1, 1, 1)
        self.pim_entry = self._make_secret_entry("empty = default")
        grid.attach(self.pim_entry, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="KDF:", xalign=1), 0, 2, 1, 1)
        self.kdf_dd = Gtk.DropDown.new_from_strings(
            [name for name, _ in KDF_CHOICES])
        self.kdf_dd.set_selected(0)              # Autodetect
        self.kdf_dd.set_hexpand(True)
        self.kdf_dd.set_tooltip_text(KDF_TOOLTIP)
        grid.attach(self.kdf_dd, 1, 2, 1, 1)
        box.append(grid)

        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        b_refresh = Gtk.Button(label="Refresh status")
        b_refresh.connect("clicked", lambda *_: self.refresh_mapping_tab())
        self.mount_btn = Gtk.Button(label="Mount all configured volumes")
        self.mount_btn.add_css_class("suggested-action")
        self.mount_btn.connect("clicked", self.on_mount)
        # Visible only while mounting; stops every running VeraCrypt process.
        self.cancel_btn = Gtk.Button(label="Cancel")
        self.cancel_btn.connect("clicked", self.on_cancel_mount)
        self.cancel_btn.set_visible(False)
        b_dismount = Gtk.Button(label="Dismount all")
        b_dismount.connect("clicked", self.on_dismount_all)
        # Shown only after a dismount left busy volumes behind.
        self.force_btn = Gtk.Button(label="Force dismount busy…")
        self.force_btn.add_css_class("destructive-action")
        self.force_btn.connect("clicked", self.on_force_dismount)
        self.force_btn.set_visible(False)
        self.spinner = Gtk.Spinner()
        btns.append(b_refresh)
        btns.append(self.mount_btn)
        btns.append(self.cancel_btn)
        btns.append(b_dismount)
        btns.append(self.force_btn)
        btns.append(self.spinner)
        box.append(btns)

        self.map_status_lbl = Gtk.Label(label="", xalign=0, wrap=True)
        box.append(self.map_status_lbl)
        return box

    # ---- secret entry fields (no visible glyph while typing) ----
    def _make_secret_entry(self, placeholder):
        e = Gtk.Entry(hexpand=True)
        e.set_buffer(Gtk.PasswordEntryBuffer())   # mlock'ed, zeroed on free
        e.set_visibility(False)            # mask + block clipboard of content
        e.set_invisible_char(MASK_CHAR)    # our chosen glyph (0 dots by default)
        e.set_placeholder_text(placeholder)
        e.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        e.set_input_hints(Gtk.InputHints.PRIVATE
                          | Gtk.InputHints.NO_SPELLCHECK
                          | Gtk.InputHints.NO_EMOJI)
        e.set_enable_undo(False)           # keep no editable history of the text
        # In-field peek toggle (eye icon); starts concealed.
        e.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                  "view-reveal-symbolic")
        e.set_icon_activatable(Gtk.EntryIconPosition.SECONDARY, True)
        e.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY,
                                "Reveal / conceal")
        e.connect("icon-press", self._on_secret_icon)
        return e

    def _on_secret_icon(self, entry, icon_pos):
        reveal = not entry.get_visibility()
        entry.set_visibility(reveal)
        entry.set_icon_from_icon_name(
            Gtk.EntryIconPosition.SECONDARY,
            "view-conceal-symbolic" if reveal else "view-reveal-symbolic")

    def wipe_secrets(self):
        """Clear password and PIM, reset the KDF choice, re-mask everything."""
        for entry in (self.pw_entry, self.pim_entry):
            entry.set_text("")             # secure buffer zeroes the old text
            self._conceal_secret(entry)
        self.kdf_dd.set_selected(0)        # back to Autodetect

    def hide_window(self):
        """Hide to the tray; nothing secret stays behind in a hidden window."""
        self.wipe_secrets()
        self.win.set_visible(False)

    def _conceal_secret(self, entry):
        entry.set_visibility(False)
        entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                      "view-reveal-symbolic")

    def _map_status(self, text):
        self.map_status_lbl.set_text(text)

    def refresh_mapping_tab(self):
        """Re-read the real state and rebuild the volume rows."""
        while (row := self.map_list.get_first_child()) is not None:
            self.map_list.remove(row)
        active = mounted_veracrypt_devices()

        # Keep known volumes (their errors survive a refresh), follow config.
        self.volumes = {dev_id: self.volumes.get(dev_id) or Volume(dev_id)
                        for dev_id in load_config()}
        for vol in self.volumes.values():
            vol.dev = (os.path.realpath(vol.dev_id)
                       if os.path.exists(vol.dev_id) else None)
            vol.mountpoint = active.get(vol.dev) if vol.dev else None
            if not vol.mounted:
                vol.pending = None                 # cleanup has finished
            self.map_list.append(self._build_volume_row(vol))

        vols = self.volumes.values()
        n_mounted = sum(1 for v in vols if v.mounted)
        self.tray_send(f"ICON {ICON_UNLOCKED if n_mounted else ICON_LOCKED}")
        self._map_status(
            f"{len(vols)} configured volume(s), "
            f"{sum(1 for v in vols if v.dev)} connected, "
            f"{n_mounted} mounted."
            if vols else "No volumes configured — use the Config tab first.")

    def _build_volume_row(self, vol):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12,
                      margin_top=4, margin_bottom=4,
                      margin_start=6, margin_end=6)
        id_lbl = Gtk.Label(label=vol.name, xalign=0, hexpand=True,
                           ellipsize=Pango.EllipsizeMode.MIDDLE)
        id_lbl.add_css_class("mono")
        dev_lbl = Gtk.Label(label=vol.dev or "—", xalign=0, width_chars=14)
        dev_lbl.add_css_class("mono")
        vol.st_lbl = Gtk.Label(xalign=0, width_chars=34, selectable=True,
                               ellipsize=Pango.EllipsizeMode.END)
        self._show_status(vol)

        # Per-volume dismount: a button, and the same in a right-click menu.
        can_dismount = vol.mounted and not vol.detached
        btn = Gtk.Button(icon_name="media-eject-symbolic")
        btn.add_css_class("flat")
        btn.set_tooltip_text("Dismount this volume")
        btn.set_sensitive(can_dismount)
        btn.connect("clicked", lambda *_: self.on_dismount_volume(vol))
        if can_dismount:
            # Capture phase, and claim the click in the handler: otherwise
            # the selectable status label opens its own copy/paste menu.
            click = Gtk.GestureClick(button=3)        # right mouse button
            click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            click.connect("pressed", self._on_row_menu, row, vol)
            row.add_controller(click)

        for widget in (id_lbl, dev_lbl, vol.st_lbl, btn):
            row.append(widget)
        return row

    def _on_row_menu(self, gesture, _n_press, x, y, row, vol):
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        pop = Gtk.Popover(has_arrow=False)
        pop.set_parent(row)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(x), int(y), 1, 1
        pop.set_pointing_to(rect)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        def item(label, handler, sensitive=True):
            b = Gtk.Button(label=label)
            b.add_css_class("flat")
            b.get_child().set_xalign(0)
            b.set_sensitive(sensitive)
            b.connect("clicked", lambda *_: (pop.popdown(), handler()))
            box.append(b)

        item("Dismount", lambda: self.on_dismount_volume(vol))
        # Offered once a normal dismount found the volume busy.
        item("Force dismount…",
             lambda: self.on_force_dismount(devices=[vol.dev]),
             sensitive=vol.dev in self.busy)
        pop.set_child(box)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    @staticmethod
    def _show_status(vol):
        text = vol.status_text()
        vol.st_lbl.set_text(text)
        # Full text on hover (errors are often longer than the column).
        vol.st_lbl.set_tooltip_text(text)

    # ---------- mounting ----------
    def on_mount(self, *_):
        if self.mount_busy:
            return
        for vol in self.volumes.values():
            vol.error = ""
        self.refresh_mapping_tab()

        targets = {v.dev: v for v in self.volumes.values()
                   if v.dev and not v.mounted}
        if not targets:
            if any(v.mounted for v in self.volumes.values()):
                self._map_status("All connected volumes are already mounted.")
            else:
                self._map_status("Nothing to mount: no configured volume is "
                                 "currently connected.")
            return

        pw = self.pw_entry.get_text()
        if not pw:
            self._map_status("Password is empty.")
            return
        pim = self.pim_entry.get_text().strip()
        if pim and not pim.isdigit():
            self._map_status("PIM must be a positive integer (or empty).")
            return
        kdf = KDF_CHOICES[self.kdf_dd.get_selected()][1]

        # Only device paths go on the command line (pkexec logs it and argv
        # is world-readable). Password, PIM and KDF travel over stdin.
        cmd = ["pkexec", HELPER, "mount"] + sorted(targets)

        if not (pim and int(pim) > 0):
            pim = ""
        secrets_in = "\n".join((pw, pim, kdf or "")).encode("utf-8") + b"\n"
        del pw

        self.mount_busy = True
        self.mount_btn.set_sensitive(False)
        self.cancel_btn.set_sensitive(True)
        self.cancel_btn.set_visible(True)
        self.spinner.start()
        self.mount_started = time.monotonic()
        self._map_status("Authenticating (polkit) and mounting in parallel…")

        threading.Thread(target=self._mount_worker,
                         args=(cmd, secrets_in, targets), daemon=True).start()

    def _mount_worker(self, cmd, secrets_in, targets):
        """Background thread: run the helper, pass each result to the GUI."""
        statuses = []
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE)
            self.mount_proc = proc
            # Password, PIM and KDF first (three lines); the pipe then
            # stays open as the helper's cancel channel ("CANCEL" line, or
            # closing when we exit).
            proc.stdin.write(secrets_in)
            proc.stdin.flush()

            for raw in proc.stdout:
                line = raw.decode("utf-8", "replace").rstrip("\n")
                if not line.startswith("RESULT\t"):
                    continue
                _, dev, status, msg = (line.split("\t", 3) + [""])[:4]
                statuses.append(status)
                if dev in targets:
                    GLib.idle_add(self._mount_result, targets[dev],
                                  status, msg)

            proc.wait()
            stderr = proc.stderr.read().decode("utf-8", "replace").strip()
            if proc.returncode in (126, 127):
                summary = "Authorization cancelled or pkexec failed."
            elif not statuses:
                summary = f"Helper produced no results. {stderr}"
            else:
                ok = statuses.count("OK")
                if "SKIPPED" in statuses:
                    summary = ("Wrong password, PIM or KDF: stopped the "
                               f"remaining disks. Mounted {ok}/{len(targets)}.")
                elif "CANCELLED" in statuses:
                    summary = f"Cancelled. Mounted {ok}/{len(targets)}."
                else:
                    summary = f"Mounted {ok}/{len(targets)} volume(s)."
                if ok == len(targets):
                    GLib.idle_add(self._mount_done, True, summary)
                    return
                summary += " Entries kept for retry."
            GLib.idle_add(self._mount_done, False, summary)
        except Exception as e:
            GLib.idle_add(self._mount_done, False, f"Error: {e}")
        finally:
            proc = self.mount_proc
            self.mount_proc = None
            if proc is not None and proc.stdin and not proc.stdin.closed:
                try:
                    proc.stdin.close()
                except OSError:
                    pass

    def on_cancel_mount(self, *_):
        proc = self.mount_proc
        if proc is None or proc.poll() is not None:
            return
        try:
            proc.stdin.write(b"CANCEL\n")
            proc.stdin.flush()
        except (OSError, ValueError):
            pass                       # helper already gone
        self.cancel_btn.set_sensitive(False)
        self._map_status("Cancelling…")

    def _mount_result(self, vol, status, msg):
        """One volume finished (called while the others may still run)."""
        if status == "OK":
            vol.error = ""
            vol.st_lbl.set_text("mounted ✓")
        else:
            # Kept until the next mount attempt, so a refresh keeps showing it.
            vol.error = (msg if status in ("CANCELLED", "SKIPPED")
                         else f"FAILED: {msg}")
            self._show_status(vol)
        return False

    def _mount_done(self, all_ok, summary):
        self.mount_busy = False
        self.mount_btn.set_sensitive(True)
        self.cancel_btn.set_visible(False)
        self.spinner.stop()
        elapsed = time.monotonic() - self.mount_started
        if all_ok:
            self.wipe_secrets()
            summary += " Password/PIM entries wiped."
        # Re-read the real state (mount points, tray icon), keeping errors.
        self.refresh_mapping_tab()
        self._map_status(f"{summary}  ({elapsed:.1f} s)")
        return False

    # ---------- dismounting ----------
    def on_dismount_all(self, *_):
        self._run_dismount()

    def on_dismount_volume(self, vol):
        if vol.dev and vol.mounted:
            self._run_dismount(devices=[vol.dev])

    def on_force_dismount(self, *_, devices=None):
        """Ask, then force-dismount the given busy volumes (default: all)."""
        devices = [d for d in (devices or self.busy) if d in self.busy]
        if self.mount_busy or not devices:
            return
        held = "; ".join(f"{d}: {self.busy[d] or 'unknown program'}"
                         for d in devices)
        dlg = Gtk.AlertDialog()
        dlg.set_modal(True)
        dlg.set_message("Force dismount busy volumes?")
        dlg.set_detail(
            f"Still in use — {held}\n\n"
            "This uses VeraCrypt's Linux emergency unmount: the folder is "
            "detached at once, but the decrypted device and its key stay in "
            "memory until those programs close their files. Then cleanup "
            "finishes by itself.\n\n"
            "Programs writing to the volume at this moment may fail and "
            "lose unsaved data. Closing them first is always safer.")
        dlg.set_buttons(["Cancel", "Force dismount"])
        dlg.set_cancel_button(0)
        dlg.set_default_button(0)
        dlg.choose(self.win, None, self._on_force_answer, devices)

    def _on_force_answer(self, dlg, result, devices):
        try:
            choice = dlg.choose_finish(result)
        except GLib.Error:
            return
        if choice == 1:
            self._run_dismount(devices=devices, emergency=True)

    def _run_dismount(self, devices=None, emergency=False):
        """Dismount the given /dev paths, or every VeraCrypt volume."""
        if self.mount_busy:
            return
        self.mount_busy = True
        self.force_btn.set_sensitive(False)
        self.spinner.start()
        self._map_status("Force-dismounting busy volumes…" if emergency
                         else "Dismounting…" if devices
                         else "Dismounting all VeraCrypt volumes…")
        cmd = ["pkexec", HELPER, "dismount"]
        if emergency:
            cmd.append("--emergency")
        cmd += devices or []

        def worker():
            results = None     # [(volume path, status, message, holders)]
            try:
                r = subprocess.run(cmd, capture_output=True, text=True)
            except Exception as e:
                error = f"Error: {e}"
            else:
                if r.returncode in (126, 127):
                    error = "Authorization cancelled or pkexec failed."
                elif r.returncode not in (0, 1):
                    error = f"Helper failed: {r.stderr.strip()}"
                else:
                    error = ""
                    results = [
                        tuple((line.split("\t", 4) + [""] * 4)[1:5])
                        for line in r.stdout.splitlines()
                        if line.startswith("DISMOUNT\t")]
            GLib.idle_add(self._dismount_done, results, error,
                          devices, emergency)

        threading.Thread(target=worker, daemon=True).start()

    def _dismount_done(self, results, error, devices, emergency):
        self.mount_busy = False
        self.spinner.stop()
        self.force_btn.set_sensitive(True)
        if results is None:                       # auth failed / crashed
            self.refresh_mapping_tab()
            self._map_status(error)
            return False

        by_dev = {v.dev: v for v in self.volumes.values() if v.dev}
        if devices is None:                       # everything was attempted
            self.busy = {}
            for vol in self.volumes.values():
                vol.error = ""

        failed, detached = [], []
        for path, status, msg, held in results:
            dev = os.path.realpath(path)
            vol = by_dev.get(dev)                 # None: not in our config
            self.busy.pop(dev, None)
            if vol:
                vol.error = ""
            if status == "OK" and emergency:
                detached.append(path)
                if vol:
                    vol.pending = held
            elif status == "ERR":
                reason = f"busy, held by {held}" if held else msg
                failed.append(f"{path}: {reason}")
                self.busy[dev] = held
                if vol:
                    vol.error = reason

        self.force_btn.set_visible(bool(self.busy))
        self.refresh_mapping_tab()   # also sets the tray icon from real state

        attempted = [r for r in results if r[1] != "PENDING"]
        if emergency:
            text = (f"Force-dismounted {len(detached)} volume(s). "
                    "Their keys leave memory once the programs holding "
                    "them close." if detached else "")
            if failed:
                text += " Failed: " + "; ".join(failed)
        elif not attempted:
            text = ("Nothing to dismount." if devices
                    else "No VeraCrypt volumes were mounted.")
        elif not failed:
            text = (f"Dismounted {len(attempted)} volume(s)." if devices
                    else f"Dismounted all {len(attempted)} volume(s).")
        else:
            text = (f"Dismounted {len(attempted) - len(failed)}/"
                    f"{len(attempted)}. Still mounted: " + "; ".join(failed)
                    + ". Close those programs and dismount again, "
                      "or use Force dismount.")
        self._map_status(text.strip())

        if not self.pending_poll and any(v.detached
                                         for v in self.volumes.values()):
            self.pending_poll = GLib.timeout_add_seconds(3, self._poll_pending)
        return False

    def _poll_pending(self):
        """Every 3 s while a forced cleanup is pending: has it finished?"""
        if self.mount_busy:
            return True
        active = mounted_veracrypt_devices()
        waiting = [v for v in self.volumes.values() if v.pending is not None]
        finished = [v.name for v in waiting
                    if not (os.path.exists(v.dev_id)
                            and os.path.realpath(v.dev_id) in active)]
        if finished:
            self.refresh_mapping_tab()           # clears their pending state
            self._map_status("Cleanup finished, key removed from memory: "
                             + ", ".join(finished))
        if len(finished) < len(waiting):
            return True
        self.pending_poll = 0
        return False


if __name__ == "__main__":
    harden_process()
    hidden = "--hidden" in sys.argv
    raise SystemExit(VCMounter(start_hidden=hidden).run(None))
